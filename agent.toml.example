# ─────────────────────────────────────────────────────────────
# Fox Agent SDK Configuration (agent.toml)
# ─────────────────────────────────────────────────────────────
#
# All fields are optional — missing fields fall back to
# their Default values (shown in comments).
#
# Usage:
#   let cfg = FoxAgentSdkConfig::load_from_file("agent.toml")?;
#   let agent = AgentBuilder::new()
#       .working_dir("./project")
#       .with_config(cfg)
#       .build().await?;
#
# ─────────────────────────────────────────────────────────────

# ── Model ───────────────────────────────────────────────────

# Default model id.  Ignored when AgentBuilder::model_id() is called.
# Falls back to "gpt-4o" when neither is set.
default_model = "deepseek-v4-flash"

# ── Storage ─────────────────────────────────────────────────

# Root directory for all persisted data.  Relative paths are resolved
# against the working_dir provided to AgentBuilder.
# Subdirectories: sessions/  planning/  memory/
storage_dir = ".fox-agent-sdk"   # default

# Persist session snapshots at key lifecycle points.
auto_snapshot = true             # default

# Optional path to a global AGENTS.md for domain-level instructions.
# global_agents_md_path = "/path/to/AGENTS.md"

# ── Provider ────────────────────────────────────────────────
# LLM provider configuration.  When set, the builder auto-creates
# the provider from this block — no need to call .provider_config().
#
# Supported provider_name values: "openai", "anthropic", "deepseek"

[provider]
provider_name = "deepseek"
base_url = "https://api.deepseek.com/"
timeout_secs = 120              # default: 60 (openai/anthropic), 120 (deepseek)
use_streaming_api = true        # default: true

# Authentication — exactly one of:
#   BearerToken = "sk-xxx"                    (OpenAI / DeepSeek)
#   { header_name = "x-api-key", value = "xxx" }  (Anthropic)
[provider.auth]
BearerToken = "sk-your-api-key-here"

# Optional: extra HTTP headers sent with every request
# default_headers = []

# ── Memory ──────────────────────────────────────────────────

[memory]
enabled = false                  # default: false — cross-session memory

# LLM wiki 模式（PRD §5）：语义召回由主 Agent LLM 完成（查询扩展 + 重排），
# 不依赖 embedding/ANN。记忆 = 条目（title/summary/aliases/tags）+ [[链接]] + 索引。
wiki_enabled = true              # default: true — 启用 LLM wiki 检索
enrich_on_write = true           # default: true — 写入后后台 LLM 增强（title/summary/aliases/[[链接]]）
query_expansion_enabled = true   # default: true — LLM 查询扩展（关闭则纯词汇召回）
rerank_enabled = true            # default: true — LLM 重排（关闭则按词汇得分截断）
rerank_candidate_multiplier = 5  # default: 5 — 词汇预筛候选数 = max_results × 倍数
link_discovery_enabled = true    # default: true — 写入时发现到已有条目的 [[链接]]
index_budget_chars = 1200        # default: 1200 — 注入的 MemoryIndex 摘要字符预算
dedupe_min_overlap_ratio = 0.6   # default: 0.6 — 词重叠比例去重阈值（Jaccard）

# Retrieval
max_candidates = 30              # max candidates before scoring
max_results = 10                 # max results after scoring
injection_max_chars = 1500       # max chars in injected memory prompt
injection_max_per_category = 3   # max memories injected per category
max_graph_depth = 2              # BFS depth in memory graph

# Relevance verification (uses LLM)
verify_relevance = false         # default
# verify_model = "gpt-4o"       # None = use agent's default model

# Auto-extraction from conversation
auto_extract = false             # default
auto_extract_scope = "Project"   # "Session" | "Project" | "Global"
auto_extract_message_window = 6  # recent messages for transcript
auto_extract_max_items_per_turn = 4

# Auto-promotion of reinforced session memories (needs auto_extract_scope = "Session")
auto_promote_enabled = false     # default — 自动提升高频会话记忆到更长寿命作用域
auto_promote_strength_threshold = 3  # default — 增强次数达到该值即提升
auto_promote_target = "Project"  # default — 提升目标作用域 ("Project" or "Global")

# Contradiction handling
contradiction_policy = "MarkContradictionEdge"  # Ignore | Supersede | DowngradeConfidence | MarkContradictionEdge
contradiction_confidence_decay = 0.2

# Retention
# retention_days = 90            # auto-delete memories older than N days
# memory_size_limit = 10_000     # max memories per scope on disk

# ── Compaction ──────────────────────────────────────────────

[compaction]
# Compaction is a LAST RESORT safety net. With 3.2M char budget (≈800K tokens),
# most sessions will never trigger it.
enabled = true                   # default: false
token_budget = 3_200_000         # default: 3,200,000
preserve_recent_messages = 80    # default: 80
max_turns_before_compaction = 500 # default: 500
context_limit_threshold = 0.90   # default: 0.90
max_compaction_count = 10        # default: 10
min_compaction_gap_turns = 20    # default: 20
llm_summary_enabled = true       # default: true — LLM structured narrative extraction

# ── Context Management ──────────────────────────────────────
# Layered context management pipeline (L2–L5).
# All layers are opt-in — disabled by default.
#
# Layers (executed in order):
#   L2: Noise Removal  — strip unreferenced lines from tool outputs
#   L3: Micro-compression — remove large tool results at high pressure
#   L4: Archival Summaries — accumulate per-turn structured narratives
#   L5: Circuit Breaker — prevent compaction thrashing loops
#   Status Bar — agent progress overlay in the dynamic prompt
#
# TOML key: [context_management]

[context_management]

# ── L2: Noise Removal ──
# When enabled, unreferenced lines in tool outputs (grep, glob, read,
# web_search, web_fetch) are replaced with omission markers.
# Full content is always recoverable via artifact_read.
l2_noise_removal_enabled = false       # default
l2_noise_reference_threshold = 0.20    # default — remove if < 20% lines referenced
l2_noise_min_output_chars = 1000       # default — skip outputs smaller than this

# ── L3: Micro-compression ──
# When context pressure exceeds the threshold, large tool results
# (> 4000 chars) are removed from the message history. The preceding
# tool_use message is also removed (becomes meaningless without result).
l3_micro_compression_enabled = false   # default
l3_pressure_threshold = 0.9            # default — 0.0–1.0, triggers at 90%
l3_max_removals = 10                   # default — max messages to remove per pass

# ── L4: Archival Summaries ──
# After each compaction, inject per-turn NarrativeSummary blocks
# into the message history. These accumulate over time (unlike L5
# which replaces old messages). Oldest narratives are trimmed when
# the count exceeds l4_max_narratives.
l4_archival_enabled = false            # default
l4_max_narratives = 20                 # default — max archived turn records
l4_per_turn_budget_chars = 500         # default — max chars per narrative

# ── L5: Circuit Breaker ──
# Prevents infinite compaction loops. When compaction fails to reduce
# message count for N consecutive attempts, the breaker opens and
# blocks further compaction for cooldown_turns.
l5_max_consecutive_failures = 3        # default — failures before opening
l5_cooldown_turns = 5                  # default — turns to wait before retry
l5_llm_summary_enabled = true          # default — bridges to compaction.llm_summary_enabled

# ── Status Bar (Phase A) ──
# Agent runtime status overlay at the end of the dynamic prompt.
status_bar_enabled = true              # default
status_bar_warn_auto_turns = 5         # default — show ⚠️ drift warning at this threshold

# ── Safety ──────────────────────────────────────────────────

[safety]
# Tool allowlist — only these tools auto-allowed (None = disabled).
# Supports `*` wildcards:
#   "mcp__akshare__*"   → all tools from the `akshare` MCP server
#   "mcp__*"            → all MCP tools from any server
#   "stock_*"           → all custom tools whose name starts with `stock_`
# tool_allowlist = ["read", "grep", "ls", "glob", "edit", "write", "bash", "webfetch", "websearch", "goal", "plan", "todo", "lsp", "invalid", "agentgrep"]


# Tool denylist — these tools always require confirmation.
# Also supports `*` wildcards.
# tool_denylist = ["bash", "webfetch"]

# Default policy for tools not in allowlist or denylist
default_policy = "Allow"         # "Confirm" | "Allow" | "Deny"

# When enabled, write/edit/non-readonly bash always ask for confirmation.
# Simpler and more reliable than guessing user intent from message keywords.
productive_tool_confirm = true    # default

# MCP server names whose tools should be auto-approved.
# Convenience shortcut — equivalent to adding "mcp__<server>__*" to allowlist.
# mcp_auto_approve_servers = ["akshare", "filesystem"]

# Approval cache
[safety.approval_cache]
enabled = true                   # default
ttl_secs = 3600                  # cache expiry (1 hour)
max_entries = 100                # max cached entries

# ── Budget ──────────────────────────────────────────────────

[budget]
# token_budget = 1_000_000       # max tokens per session (None = unlimited)
# cost_budget_cents = 500        # max cost in USD cents (None = unlimited)
provider_timeout_secs = 120      # default
provider_retries = 2             # default
tool_timeout_secs = 60           # default — tool execution timeout
tool_concurrency_limit = 8       # default — max parallel tool calls
max_turns = 0                    # default: 0 = unlimited

# ── MCP ─────────────────────────────────────────────────────

[mcp]
enabled = false                  # default — MCP integration
connect_timeout_secs = 30        # default
tool_timeout_secs = 60           # default — per MCP tool call
max_concurrent_tools = 4         # default
auto_refresh_tools = false       # default
tool_refresh_interval_secs = 0   # default: 0 = disabled
max_reconnect_attempts = 3       # default
reconnect_backoff_ms = 1000      # default
default_risk_level = "High"      # "Low" | "Medium" | "High" | "Critical"
expose_resources = false         # default
max_resources_per_injection = 5  # default

# ── Skills ──────────────────────────────────────────────────
#
# Claude Code compatible skill system.
# Skills are YAML-frontmatter markdown files loaded from:
#   1. <working_dir>/.claude/skills/  (project, highest priority)
#   2. {storage_dir}/skills/          (global)
#   3. additional_directories (custom)
#   4. Installed plugins

[skills]
enabled = true                   # default
load_global = true               # default — load from {storage_dir}/skills/

# Additional skill directories (absolute paths)
# additional_directories = ["/path/to/custom/skills"]

# Reload strategy: "Auto" (fs watcher, not yet implemented) or "Manual" (load at build)
reload_strategy = "Manual"       # default

# ── Hooks ───────────────────────────────────────────────────
#
# Claude Code compatible hook system.
# Hooks are shell scripts triggered at lifecycle events:
#   PreToolUse, PostToolUse, PreCompact, SessionStart, Stop, etc.
#
# Hook JSON files are loaded from:
#   1. <working_dir>/.claude/hooks/   (project)
#   2. {storage_dir}/hooks/           (global)
#   3. additional_directories (custom)

[hooks]
enabled = true                   # default
timeout_secs = 30                # default — hook execution timeout
max_concurrent = 5               # default — max concurrent hooks per event

# Whether to load global hooks from {storage_dir}/hooks/
load_global = true               # default

# Additional hook directories (absolute paths)
# additional_directories = ["/path/to/custom/hooks"]

# ── Plugins ─────────────────────────────────────────────────
#
# Claude Code compatible plugin system.
# Plugins bundle skills + hooks and can be installed from marketplaces.
#
# The SDK automatically:
#   1. git-clones marketplace repos to {storage_dir}/plugins/marketplaces/
#   2. Reads .claude-plugin/marketplace.json (Claude Code standard format)
#   3. Caches the index to {name}.json for fast subsequent access
#   4. On `fox-code plugin install <name>`, searches cached indexes,
#      refreshes any missing ones, git-clones the plugin repo, and
#      loads its skills into the agent's skill registry.

[plugins]
enabled = true                   # enable plugin system
auto_update_hours = 0            # default: 0 = disabled

# Plugin names to auto-install on startup (from configured marketplaces)
# preinstall = ["code-review"]

# ── Plugin Marketplaces ──
# Each marketplace is a source of installable plugins.
#
# Supported source types: "GitHub", "Git", "Http", "Local"
#
# Claude Code default marketplaces:
[[plugins.marketplaces]]
name = "claude-plugins-official"
source = "GitHub"
owner = "anthropics"
repo = "claude-plugins-official"
branch = "main"
auto_update_hours = 12

[[plugins.marketplaces]]
name = "claude-plugins-community"
source = "GitHub"
owner = "anthropics"
repo = "claude-plugins-community"
branch = "main"
auto_update_hours = 24

# Example custom GitHub marketplace:
# [[plugins.marketplaces]]
# name = "my-team"
# source = "GitHub"
# owner = "your-org"
# repo = "fox-agent-plugins"
# branch = "main"
# auto_update_hours = 12

# Example HTTP marketplace:
# [[plugins.marketplaces]]
# name = "internal"
# source = "Http"
# url = "https://plugins.example.com/index.json"
# auto_update_hours = 24

# ── Proxy ───────────────────────────────────────────────────
#
# Proxy all outbound connections through a proxy server.
# Applies to:
#   - Provider API calls (LLM requests)
#   - MCP transport connections
#   - HTTP tool calls (webfetch, websearch)
#   - Git clone/fetch for marketplace repos and plugin installs
#   - Marketplace HTTP index downloads
#
# Supports HTTP, HTTPS, and SOCKS5 proxies.

# [proxy]
# url = "http://127.0.0.1:7890"       # proxy URL (required)
# username = ""                       # optional basic auth
# password = ""                       # optional basic auth
# no_proxy = ["localhost", "*.local"] # hosts to bypass

